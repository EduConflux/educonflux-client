# ========================================================
# EduConflux Client Environment Variables
# ========================================================

# For Local Development (leave defaults or empty to use Vite proxy):
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=/ws

# For Vercel Production Deployment:
# Point to your live Render backend URL:
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api
VITE_WS_BASE_URL=https://your-backend-app.onrender.com/ws
